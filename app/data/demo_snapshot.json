   "DOC_TYPE": "RBI",
   "SECTION_NUMBER": "Para 18",
   "SECTION_TITLE": "Structuring",
   "CHUNK_TEXT": "Structuring refers to the practice of breaking up large cash transactions into smaller amounts just below the reporting threshold to evade CTR requirements. Banks shall be vigilant for structuring patterns including but not limited to: multiple cash deposits of amounts just below Rs. 10 lakh by the same customer on the same day or over several days; multiple customers making cash deposits below the threshold into the same account; and transactions that do not match the declared business profile.",
   "EFFECTIVE_DATE": "2023-01-01",
   "JURISDICTION": "INDIA"
  },
  {
   "CHUNK_ID": "RBI-KYC-006",
   "DOC_NAME": "RBI Master Direction - Know Your Customer (KYC) Direction, 2016 (Updated 2023)",
