# Environment Variables for SentinelReg
# Copy this file to .env and fill in your values

# Snowflake Connection
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SENTINEL_REG_ROLE
SNOWFLAKE_WAREHOUSE=SENTINEL_REG_WH
SNOWFLAKE_DATABASE=SENTINEL_REG
SNOWFLAKE_SCHEMA=DATA

# Cortex Agent Config
SENTINEL_REG_PAT=your_personal_access_token
SENTINEL_REG_HOST=your_account.snowflakecomputing.com
SENTINEL_REG_AGENT_DB=SNOWFLAKE_INTELLIGENCE
SENTINEL_REG_AGENT_SCHEMA=AGENTS
SENTINEL_REG_AGENT_NAME=AML_RISK_AGENT

# App Config
APP_ENV=development
LOG_LEVEL=INFO
